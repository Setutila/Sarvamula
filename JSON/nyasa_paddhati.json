      }
    },
    "b14b8e60-2950-413e-8b27-10a6708408f7": {
      "text": "अत्यन्ताशक्तविषये त्वेकं स्नानं स्मृतं बुधैः॥ १०॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "53d857fe-dd89-4cdf-898d-9c63413ef7c8": {
      "text": "वेदान्तशास्त्राभ्यसनं मुख्यधर्मो यतेः स्मृतः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "c1992b86-2282-48a7-9631-58498d45dd61": {
      "text": "देवो नारायणो नित्यं सृष्टिस्थित्यन्तकारकः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b370c646-bced-4c96-b8ce-b1fe51e1064d": {
      "text": "भक्तानां मुक्तिदो नित्यमन्यथाज्ञानिनां तमः॥ ११॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "997c7222-addf-46a9-a492-ac82bb7e8c1b": {
      "text": "पूर्णप्रज्ञेन मुनिना व्यासवाक्यसमुद्धृतिः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "f56788e9-24cd-420b-8d1c-913e272e8735": {
      "text": "न्यासधर्मस्य विषये शुभा सङ्क्षेपतः कृता॥ १२॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "cc234b54-87ef-4ac9-800f-f5d5cccca1e5": {
      "text": "॥ इति श्रीमदानन्दतीर्थभगवत्पादकृता न्यासपद्धतिः समाप्ता॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    }
  }
}
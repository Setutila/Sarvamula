{
  "title": "तत्त्वविवेकः",
  "content": [
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "121bb200-6c2d-4964-8b37-ebf7abbd978c",
          "text": "प्रमेयविवेकः"
        }
      ]
    },
    {
      "content_type": "Heading2",
      "children": [
        {
          "id": "654370a7-23e0-46a4-86ce-4f1f60ad76b7",
          "text": "तत्त्वस्य सामान्यविभागोद्देशौ"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "padya": true,
          "children": [
            {
              "id": "1d9a14ff-67b1-410b-ae82-d20cc3ca50ed",
              "text": "ॐ॥"
            }
          ]
        },
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "5d0c67e9-0155-49e4-b0df-cbd1ed61e6f7",
                  "text": "“स्वतन्त्रं परतन्त्रं",
                  "bg_patha": "स्वतन्त्रमस्वतन्त्रं",
                  "trk_patha": "स्वतन्त्रं परतन्त्रं"
                },
                {
                  "id": "abd57329-beb3-4410-a1ca-a4a13528f387",
                  "text": "च प्रमेयं द्विविधं मतम्।"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading2",
      "children": [
        {
          "id": "c64b88b2-5f00-4d61-9178-3f301f4c60ea",
          "text": "स्वतन्त्रप्रमेयोद्धेशः, तदुपपादनं च"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "0d267acd-7d3c-45b3-87b8-e79317b19306",
                  "text": "स्वतन्त्रो भगवान् विष्णुर्निर्दोषाखिलसद्गुणः॥ १॥"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading2",
      "children": [
        {
          "id": "b60ba919-79eb-4960-8ed3-dd7a4d719d65",
          "text": "परतन्त्रप्रभेदाः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "941a1843-9f72-446b-ad1d-b2e9e58b041d",
                  "text": "द्विविधं परतन्त्रं च भावोऽभाव इतीरितः।"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading3",
      "children": [
        {
          "id": "b0c5af9d-75bb-4a15-b72b-5a0ee4eda043",
          "text": "अभावप्रभेदाः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "a1632bf2-96c4-4896-946d-641fee709249",
                  "text": "पूर्वापरसदात्वेन त्रिविधोऽभाव इष्यते॥ २ ॥"
                },
                {
                  "id": "20a8d91e-b9a4-489d-875a-60444259b7fc",
                  "text": "भावाभावस्वरूपत्वान्नान्योन्याभावता पृथक्।"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading3",
      "children": [
        {
          "id": "2f28dbb7-ad8b-444b-8e6f-dc8e05ccacfd",
          "text": "भावविभागः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "c2b92d81-cf61-4c4d-a404-84dd4d1cd217",
                  "text": "चेतनोऽचेतनश्चेति भावश्च द्विविधः स्मृतः॥ ३॥",
                  "bg_patha": "चेतनोऽचेतनश्चेति भावोऽपि द्विविधः स्मृतः॥ ३॥",
                  "trk_patha": "चेतनोऽचेतनश्चेति भावश्च द्विविधः स्मृतः॥ ३॥"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading3",
      "children": [
        {
          "id": "eda90c39-bd52-426a-86b9-9a805d1a6376",
          "text": "चेतनविभागादि"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "3dcb748b-a921-421a-bc35-ae81d15e0e23",
                  "text": "नित्यमुक्तश्च सृतियुक् परतन्त्रोऽपि चेतनः।"
                },
                {
                  "id": "91e63d68-0d11-4310-8e5f-a4714e730fdb",
                  "text": "द्विधैव श्रीर्नित्यमुक्ता सृतियुक् च द्विधा मतः॥ ४॥"
                },
                {
                  "id": "77f8cb4f-7b7e-4755-aafb-997a5245d846",
                  "text": "मुक्तोऽमुक्त इति ह्यत्र ब्रह्मान्ता उत्तरोत्तरम्।"
                },
                {
                  "id": "d093f3c1-d49f-499e-a1e2-be866b09e74a",
                  "text": "मुक्ताः शतगुणाः प्रोक्ता रमा तेभ्योऽखिलैर्गुणैः॥ ५॥"
                },
                {
                  "id": "5d8165c7-c606-4e8d-8c98-78bfe8e19098",
                  "text": "नित्यं बहुगुणोद्रिक्ता ततोऽनन्तगुणो हरिः।"
                },
                {
                  "id": "da7caee4-1a41-4cfa-bb85-9998af84b5e2",
                  "text": "अमुक्तास्त्रिविधास्तत्र नीचमध्योच्चभेदतः॥ ६ ॥"
                },
                {
                  "id": "d2ce734a-925f-475b-b554-25bbdb56b717",
                  "text": "मुक्तियोग्यास्तत्र चोच्चा नित्यवर्तास्तु मध्यमाः।"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        },
        {
          "padya": true,
          "children": [
            {
              "id": "177b520f-310e-4b7d-86ad-7243659ed21f",
              "text": "नीचा नित्यतमोयोग्याः --- --- --- ---"
            }
          ]
        }
      ]
    },
    {
      "content_type": "Heading3",
      "children": [
        {
          "id": "a1866a46-46a4-4ca5-bcca-d8722bf526b9",
          "text": "अचेतनविभागादि"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "f6b094a1-060f-462b-a537-6674bcc4b323",
                  "text": "--- --- --- --- द्विधैवाचेतनं मतम्॥ ७॥"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "padya": true,
          "children": [
            {
              "id": "71369d8b-d181-425e-a8de-1f219347d093",
              "text": "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा।"
            },
            {
              "id": "1cdd7612-383a-4ef0-b570-23a70b1c8fae",
              "text": "भूतेन्द्रियप्राणगुणसूक्ष्मरूपं च नित्यकम्॥ ८॥"
            }
          ]
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "padya": true,
          "children": [
            {
              "id": "85f86172-bc8d-4dc7-98d0-0eeab8485fae",
              "text": "एषां विकारोऽनित्यः स्यात्  --- --- --- ---"
            }
          ]
        }
      ]
    },
    {
      "content_type": "Heading2",
      "children": [
        {
          "id": "64dbca17-dbc7-4dc8-b1bf-cc6a9b411e76",
          "text": "अनुक्तसङ्ग्रहसूचना"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "990b2565-a62e-473b-bfa8-db7da3a04f2d",
                  "text": "--- --- --- ---   नित्या एव हि चेतनाः।"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "4cd1a829-d433-47d0-9527-d250db435f9c",
          "text": "गुणादिविवेकः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "df766e57-6da6-4307-8f80-9946101d6494",
                  "text": "गुणक्रियाजातिपूर्वा धर्माः सर्वेऽपि वस्तुनः॥ ९॥"
                },
                {
                  "id": "a58fce60-d591-44cf-b0b6-ff38d558d230",
                  "text": "रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम्।",
                  "pathanatara": "“द्विधा तच्च” इति प्रचलितपाठ इति गोविन्दाचार्याः। कृपाठे तु नैवं पठ्यते।"
                },
                {
                  "id": "b9f490ec-be09-404f-b76f-add7bd37de68",
                  "text": "खण्डिते भेद ऐक्यं च यावद्वस्तु न भेदवत्॥ १०॥"
                },
                {
                  "id": "71f41d6f-3b69-4830-92a9-e11d1058e7b9",
                  "text": "खण्डितं रूपमेवात्र विकारोऽपि विकारिणः।"
                },
                {
                  "id": "00bc8562-580b-49a8-8df1-90c47e52cb23",
                  "text": "कार्यकारणयोश्चैव तथैव गुणतद्वतोः॥ ११॥"
                },
                {
                  "id": "40b91003-4f52-4b64-8e91-3536886398aa",
                  "text": "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः।",
                  "bg_patha": "क्रियाक्रियावतोश्चैव तथैवांशांशिनोरपि॥ १२॥",
                  "trk_patha": "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः।"
                },
                {
                  "id": "bdf00440-8ef3-4561-a84b-5a5fd8fde670",
                  "text": "विशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि॥ १२॥",
                  "trk_patha": "विशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि॥ १२॥"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "b51ac388-ec04-4f72-913b-a728a46ab5c5",
          "text": "उपसंहारः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "29f0e74d-0733-4a85-9bd6-ea0b7735f519",
                  "text": "य एतत् परतन्त्रं तु सर्वमेव हरेः सदा।"
                },
                {
                  "id": "79897d11-00f9-4269-b00a-77b2d5c8dfc1",
                  "text": "वशमित्येव जानाति संसारान्मुच्यते हि सः॥ १३॥”"
                }
              ]
            }
          ],
          "source": "तत्त्वविवेकः",
          "pramana_info": "अन्यत्रोक्तिः/टीकोक्तिः"
        }
      ]
    },
    {
      "content_type": "Colophon_Sarvamula",
      "children": [
        {
          "id": "4cf5a25b-c1ef-4bfc-ad5d-d76d289d32b0",
          "text": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितस्तत्त्वविवेकः सम्पूर्णः॥"
        }
      ]
    }
  ],

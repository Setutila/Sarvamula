      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "तन्मध्यपद्मस्थं",
        "trk_patha": "तत्पद्ममध्यस्थं"
      }
    },
    "198bfa47-6939-43f1-8b90-7d3b7631fd52": {
      "text": "उद्यदादित्यसङ्काशं तेजसाऽनुपमं सदा।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "a5c14390-50e1-4908-9f08-9eda5f8d07df": {
      "text": "सहस्रेणापि सूर्याणां सज्ज्ञानानन्दरूपिणम्॥ ८॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "57ee8223-2cc8-4fd9-ab8e-d787fbae11dd": {
      "text": "अतिरक्ततलं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "अतिरक्ततळं",
        "trk_patha": "अतिरक्ततलं"
      }
    },
    "a8625903-b8e4-4630-aa8d-97c6d9238b8c": {
      "text": "भास्वन्नखव्रातविभूषितम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "98a9d04e-f313-4fed-b292-4f90d9127462": {
      "text": "वृत्तजङ्घं वृत्तजानुं हस्तिहस्तोरुमीश्वरम्॥ ९॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "9d16aa66-ae9c-43c2-b22d-35239da2e36e": {
      "text": "महाकटितटाबद्धकाञ्चीपीताम्बरोज्ज्वलम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "c01943bd-6200-4cb8-b25a-b5f2b3eb68e6": {
      "text": "सुनिम्ननाभिं त्रिवलिं सुवृत्तोदरबन्धनम्॥ १०॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "निम्ननाभिं च त्रिवलिसंवृत्तोदरबन्धनम्॥",
        "trk_patha": "सुनिम्ननाभिं त्रिवलिं सुवृत्तोदरबन्धनम्॥"
      }
    },
    "ad529027-e110-4137-acf6-e041dfac8f6b": {
      "text": "विशाळवक्षसं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "विस्तारिवक्षसं",
        "trk_patha": "विशाळवक्षसं"
      }
    },
    "24dbc483-7363-49f5-a0cf-f1a4060e0b7c": {
      "text": "भ्राजत्कौस्तुभामुक्तकन्धरम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "be38d9ef-4e00-4c2d-8e33-c228eaaed68f": {
      "text": "वनमालाधरं हारवैजयन्त्यादिभिर्युतम्॥ ११॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "233f7853-1a84-4c4c-9263-438ce4e251e3": {
      "text": "पृथुदीर्घचतुर्बाहुं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "56399a05-6eef-4354-9321-f882e29e5603": {
      "text": "चक्रशङ्खगदाम्बुजैः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "शङ्खचक्रगदाम्बुजैः।",
        "trk_patha": "चक्रशङ्खगदाम्बुजैः।"
      }
    },
    "bd623a3b-8271-4719-be45-62bc56d06614": {
      "text": "युक्तमुन्निद्रपद्माक्षं स्फुरन्मकरकुण्डलम्॥ १२॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "8cd90621-e6d1-40e2-be84-b4d680522698": {
      "text": "पूर्णचन्द्रायुतोद्रिक्तकान्तिमन्मुखपङ्कजम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "e019d8c4-fd61-4183-affb-4d25bbef98e9": {
      "text": "सुभ्रुवं सुललाटान्तं किरीटाबद्धमूर्धजम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "e3c24d56-61ee-4efd-9ada-7c2647925b2a": {
      "text": "निःशेषदुःखदमनं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "निःशेषदुःखशमनं",
        "trk_patha": "निःशेषदुःखदमनं"
      }
    },
    "957034aa-2459-48ce-a872-62a83e70db3f": {
      "text": "नित्यानन्दं शुचिस्मितम्॥ १३ ॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d60e58bf-8e67-4bc4-82fd-08fb1c381ea5": {
      "text": "विश्वादींश्चैव कृष्णादीनेवम्भूतान् सनातनान्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "4fea78ea-78ae-4b86-8090-8a28d8fab5cb": {
      "text": "अभिन्नानेव सततं तस्माद् विष्णोः परात्मनः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "6fd6ba51-efe1-427c-ab16-0bf68f664aa6": {
      "text": "वराभयोद्यतकरान् नित्यानन्दैकरूपिणः॥ १४॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "6aac9986-93e2-4c64-ac74-d138a81d09f6": {
      "text": "शिष्येण शपथस्वीकारः",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "4bcaa00e-3160-42a8-94ef-560769f259a6": {
      "text": "एवमुक्त्वा गुरुर्ध्यानं शपथं कारयेत् ततः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "c50a037b-1abe-445d-9b66-16000a4d5179": {
      "text": "न विष्णुं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "14b0fc6e-a9b9-4c07-b2bf-5dea315f9664": {
      "text": "वैष्णवांश्चैव विसृजेयमिति",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "वैष्णवांश्चैवाप्युत्सृजेयमिति",
        "trk_patha": "वैष्णवांश्चैव विसृजेयमिति"
      }
    },
    "70113e22-f23f-4369-ae55-91566a35ded8": {
      "text": "त्रिशः॥ १५॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "bb9f71d9-2067-4b90-9813-d7bb5e68fef3": {
      "text": "नचान्यदेवतासाम्यं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "नचान्यदेवसामान्यं",
        "trk_patha": "नचान्यदेवतासाम्यं"
      }
    },
    "759db1c7-6e3d-4f02-aa15-20cd8b28b6b6": {
      "text": "तदैक्यमथवा हरेः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "f4295ba6-7a77-4af8-ac32-e183992ac2b7": {
      "text": "चिन्तयेयं मृतौ वाऽपि नचाप्येकत्ववादिभिः॥ १६॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "459b189f-b664-4294-b037-c496f7ba458f": {
      "text": "समत्ववादिभिर्वाऽहं सङ्गच्छेयं कदाचन।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "663153d7-293d-4add-99e4-6e9258769a38": {
      "text": "तन्निन्दकैश्च तद्भक्तनिन्दकैर्वा महामुने॥ १७॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "cdf0f372-03eb-4d16-a709-568c4e298099": {
      "text": "गुरोराशीर्वचनम्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "084b4f32-d968-43e9-83fb-651d7ebf533e": {
      "text": "एवं कृते तु शपथे मस्तके हस्तपङ्कजम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b05687c7-b641-4a6c-b190-b09ec487567c": {
      "text": "निधायोत्तीर्य संसारात् सुखी भव हरेः प्रियः॥ १८॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "5933b53e-f8e8-403c-9d7d-b5e5b205eb19": {
      "text": "सर्वदुःखदिभिर्मुक्तो नित्यानन्दैकरूपकः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "86e1fe9a-8d4e-412b-8c44-feead1460bbf": {
      "text": "सम्प्राप्य विष्णुसामीप्यं तत्रापि हरिभक्तिमान्॥ १९॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "09d12d23-38d1-49d0-aa38-9592e60832fc": {
      "text": "भक्तिमांश्चान्यदेवेषु",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "भक्तिमांश्चाथ देवेषु",
        "trk_patha": "भक्तिमांश्चान्यदेवेषु"
      }
    },
    "cd7505ee-5d55-483c-a831-2a97c05d78c5": {
      "text": "तारतम्यं च संस्मरन्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "2602abf0-d976-42a1-b74d-d7a99f3aa927": {
      "text": "सर्वोत्कर्षं स्मरन् विष्णोर्भूयाश्चैव सदा सुखी॥ २०॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "2241e71e-c269-4844-b3f0-6cc25a10229f": {
      "text": "न मुक्तौ विष्णुनैक्यं वा मुक्तानां साम्यमेव वा।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "cc157488-0886-4582-914a-f2f89bb35064": {
      "text": "स्मरेथा इति",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "164fb419-43a7-4607-a693-0351d7e4087a": {
      "text": "चोक्त्वाऽथ समयाननुशिक्षयेत्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "चोक्त्वा तत्समयाननुशिक्षयेत्",
        "trk_patha": "चोक्त्वाऽथ समयाननुशिक्षयेत्"
      }
    },
    "a69f3ea7-63fa-45e5-8d1b-a0bcaec92ad1": {
      "text": "॥ २१॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "0b6b5b86-698e-48ea-a658-f620d4bf9cbf": {
      "text": "गुरोरादेशः",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b34e7361-d63a-4ca3-bee6-88afa83b442f": {
      "text": "नित्यशश्च हरेः पूजा",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "c460b6c2-3f49-4e92-81b0-10f9b2b9ad32": {
      "text": "जपध्यानसमर्पणम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "जपध्यानसमर्पया।",
        "trk_patha": "जपध्यानसमर्पणम्।"
      }
    },
    "e377443a-f3cc-4eb0-a506-a41eab1dbda5": {
      "text": "कर्तव्यं तु",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "कर्तव्यैव",
        "trk_patha": "कर्तव्यं तु"
      }
    },
    "ceeb92d1-02fd-4c7d-8fb3-e1e77b83b5ca": {
      "text": "त्वया वत्स जपश्च त्रिसहस्रकः॥ २२॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "ee83404c-a10a-4559-bba7-88a23ada79a5": {
      "text": "मध्यमः प्रणवस्योक्तो योऽवरः स सहस्रकः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "7b767d2a-60ad-4e3f-9990-8bc641da9b87": {
      "text": "त्रिसहस्रात् परो यस्तु स उत्तमजपः स्मृतः॥ २३॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "22f40282-9ac4-455a-ba0a-acfa19e40c15": {
      "text": "आत्मानं प्रतिबिम्बत्वे ध्यायन् बिम्बं जनार्दनम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "1893ca10-032b-430f-854a-942bcb750537": {
      "text": "ध्यायस्व सततं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "f80ef01a-2f09-4294-82dc-37a69f1940c4": {
      "text": "वत्स",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "पुत्र",
        "trk_patha": "वत्स"
      }
    },
    "418936b4-cb09-480c-9c3f-5a749167e3b9": {
      "text": "सपर्यां नित्यशः कुरु।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "f4e23444-ab9b-4de4-b461-755880735ec0": {
      "text": "मानसैर्वाऽथ",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "मानसेनाथ",
        "trk_patha": "मानसैर्वाऽथ"
      }
    },
    "47cea338-fa37-46f9-ad34-8c126048a933": {
      "text": "पुष्पैर्वा प्रणवेन समाहितः॥ २४॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "64a6fc7d-899d-4e72-882a-019686a99457": {
      "text": "अन्यांश्च वैष्णवान् मन्त्राञ्जपेथा भक्तिपूर्वकम्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "4d031b87-ac96-4649-941f-320b2fc0fd21": {
      "text": "शृणुष्व वैष्णवं शास्त्रं सदा वेदार्थतत्परः॥ २५॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "6bc18ceb-dc31-4a6b-804d-72a3d615ca90": {
      "text": "वेदान् मन्त्रानुपनिषत्सहितान् सर्वदा शृणु।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b6880301-9a95-4cc2-bd89-09d043779b33": {
      "text": "इतिहासपुराणं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "इतिहासपुराणे",
        "trk_patha": "इतिहासपुराणं"
      }
    },
    "8d363a56-e421-4847-a6e9-c7812e226d43": {
      "text": "च पञ्चरात्रं तथैव च॥ २६॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d64a1718-6a00-4569-be99-e72398e61df4": {
      "text": "तदर्थान् ब्रह्मसूत्रैश्च सम्यङ् निर्णीय तत्त्वतः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "fb7b597a-8d0d-48ab-8b27-86cbff70ee07": {
      "text": "विष्णोः सर्वोत्तमत्वं",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "302a2541-93f4-42c1-b90f-58c55d869792": {
      "text": "च",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "तु",
        "trk_patha": "च"
      }
    },
    "81e2c835-ffee-43c3-87fa-2a038c4d777e": {
      "text": "सर्वदा प्रतिपादय॥ २७॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "cdec233f-4f8d-4d21-90fb-279f0055f3bb": {
      "text": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितो यतिप्रणवकल्पः सम्पूर्णः॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितः ओन्तत्सत्प्रणवकल्पः समाप्तः॥",
        "trk_patha": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितो यतिप्रणवकल्पः सम्पूर्णः॥"
      }
    }
  }
}
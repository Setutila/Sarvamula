    "19165c24-b184-42ec-889d-3ab2a6691109": {
      "text": "‘रजतं दृष्टम्’ इति भ्रममात्रत्वात् ‘विमतं सत्यं दृश्यत्वात्, आत्मवत्‌’ इत्यपि प्रयोज्यत्वात् प्रकरणसमः।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "",

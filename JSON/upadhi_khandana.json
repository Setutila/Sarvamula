        "trk_patha": ""
      }
    },
    "d8297bc9-1d68-4567-8dd5-4ba3f5742b8c": {
      "text": "अशेषदोषरहितः प्रीयतां",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "3de0a415-9a0e-4cdd-8c83-b0de0464fdfe": {
      "text": "कमलालयः",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "कमळालयः",
        "trk_patha": "कमलालयः"
      }
    },
    "0380be51-7a92-41a3-b1a0-454e43667953": {
      "text": "॥ १॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "60853f58-2c97-4b37-9185-6450d87b39d4": {
      "text": "मायावाद-भास्करमतयोः क्रमेण निराकरणम्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "9932f4a9-c06c-4a00-8092-89d2026dd966": {
      "text": "अज्ञताऽखिलसंवेत्तुर्घटते न कुतश्चन।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "12b4fac0-0800-436f-9300-ce39b8c50f50": {
      "text": "उपाधिभेदाद् घटत इति चेत् स स्वभावतः॥ २॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "9ef29020-d2c6-49bf-999b-ae6baf6fb520": {
      "text": "अज्ञानतो वा द्वैतस्य सत्यता स्वत एव चेत्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "81b95f87-6bf0-4f2a-89ee-9f622c41780b": {
      "text": "अनवस्थितिरज्ञानहेतौ वाऽन्योन्यसिद्धिता॥ ३॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "a45cb238-7de8-4427-a686-21abbc528d82": {
      "text": "चक्रकापत्तिरथवा भेदश्चोपाधितः कुतः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "10c36965-0a50-4671-b98b-8b52fe3afbd5": {
      "text": "विद्यमानस्य भेदस्य ज्ञापको नैव कारकः॥ ४॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "a09f1caf-6431-4557-9bed-4efce869b0f7": {
      "text": "उपाधिर्दृष्टपूर्वो हि खेऽपि देशान्तरस्य सः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "2cbddc40-f915-4d7a-9cc0-e3d38a9e3b25": {
      "text": "ज्ञापको विद्यमानस्य मूढबुद्धिव्यपेक्षया॥ ५॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d8a81cd1-5f81-4291-96c8-9bd45bdc72ca": {
      "text": "न चेदुपाधिसम्बन्ध एकदेशेऽथ सर्वगः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d291d701-d982-4bfc-9c7f-a2697488c002": {
      "text": "एकदेशेऽनवस्था स्यात् सर्वगश्चेन्न भेदकः॥ ६॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "37dc5c6a-b90b-4d52-9923-837d24ee471a": {
      "text": "सुखदुःखादिभोगश्च स्वरूपैक्ये न भेदतः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "55e532d0-3db7-4c5c-962e-807a079a5d0b": {
      "text": "दृश्यो ह्युपाधिभेदेऽपि हस्तपादादिगो यथा॥ ७॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "58e828a8-9a8d-49dc-9993-1d5bcf9c4d16": {
      "text": "नानादेहगभोगानुसन्धानं योगिनो यथा।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b4739bc3-c595-43a5-a770-7383917398be": {
      "text": "न चेद् भोगानुसन्धानं तदिच्छा योगिनः कुतः॥ ८॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "823ee35e-8f97-4ded-9532-77712ab85aa5": {
      "text": "अनुसन्धानरहितदेहबाहुल्यमन्यथा।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "dad5f425-a5cd-4faf-b04d-e2b34ca05ecb": {
      "text": "सिद्धमेव हि तत्पक्षे विशेषो योगिनः कुतः॥ ९॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "88ac3f80-b2fd-45cf-82ca-f605d8d8c55c": {
      "text": "सिद्धौ हि कर्मभेदस्य स्यादुपाधिविभिन्नता।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "f364c0ec-e085-4f2a-afa8-101bdf86235c": {
      "text": "तत्सिद्धौ चैव तत्सिद्धिरित्यन्योन्यव्यपाश्रयः॥ १०॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "e203c4fd-b92f-4eab-8d4f-9191ae54c39d": {
      "text": "उभयोरपि साधारणदोषेण दूषणम्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "57879a84-fe9b-42ec-967c-025fa1bd90e1": {
      "text": "आत्मस्वभावभेदस्य विदोषत्वेन चाखिलः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "8eef5209-cd75-43a9-bc5b-5a7edf0ff7a8": {
      "text": "प्रत्यक्षादिविरोधाच्च दुष्टः पक्षोऽयमञ्जसा॥ ११॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d6b9ceea-c7ff-4087-b118-296d985657ca": {
      "text": "चेष्टालिङ्गेन सात्मत्वे परदेहस्य साधिते।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "2e19b691-b93c-46bb-bb6a-412dd43c808f": {
      "text": "अन्यत्वं स्वात्मनस्तस्मात् सर्वैरेवानुभूयते॥ १२॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "709e93f5-93eb-4932-8f47-40c44566ea05": {
      "text": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "59393186-0573-4c6d-8b40-550d299e0f6b": {
      "text": "सर्वज्ञतादीशगुणविरुद्धा ह्यनुभूतिगाः॥ १३॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "38555ded-8264-46f4-a33c-b12358f596d4": {
      "text": "सार्वज्ञादिगुणा विष्णोः श्रुतिषु प्रतिपादिताः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "9c5bdcf7-4fb9-4df6-b408-3e2e72eaf6a6": {
      "text": "“सत्यः सो अस्य महिमा”",
      "kutra": "ऋग्वेदसंहिताया ८/३/४",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d436d48b-380c-484f-8cae-dfe9f3150a93": {
      "text": "इत्यादिवाक्यान्मृषा नच॥ १४॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "fda5a9a0-9eb9-43ff-bced-a815ccb0f567": {
      "text": "नच वेदोक्तमिथ्यात्वे मानं तन्मानताऽपि न।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "e88868b6-0e9f-4e07-b45a-8e5ccb9b0bdb": {
      "text": "अद्वैतमतेऽधिकार्याद्यभावसमर्थनम्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "0fd2babe-31a2-4897-91a2-7aa47e35c0b1": {
      "text": "अतोऽज्ञासम्भवादेव नाधिकार्यैक्यवादिनाम्॥ १५॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b936c180-eaaf-4bf3-971a-4544c58d11d3": {
      "text": "अतो नाज्ञातमिति च विषयो विषयान्तरे।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "dd9de1ae-c5b2-4387-ab13-7b4055d04c3d": {
      "text": "अज्ञाभावात् फलं कस्य योगः शशनृशृङ्गयोः॥ १६॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "d08a5ed4-f99e-412e-87bf-826043a0e80c": {
      "text": "अज्ञानदौर्घट्यस्य भूषणत्वदूषणम्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "f7dcd426-ab27-44ca-97d7-f8b476b0fb80": {
      "text": "दुर्घटत्वं भूषणं चेत् स्यादविद्यात्वमात्मनः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "ba9d6c7f-89b0-4e7c-bc01-9d546db533f6": {
      "text": "अन्धन्तमोऽप्यलङ्कारो नित्यदुःखं शिरोमणिः॥ १७॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "4ad85445-8ebd-4eb7-b5c1-d8d4ea1a03a4": {
      "text": "भेदमते विषयादिसद्भावप्रतिपादनम्",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "9628b38a-0071-46d0-9af3-b3b769728a3d": {
      "text": "अतः",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "09c3f30a-05f1-4647-b2c8-2e7955d9d750": {
      "text": "“परो मात्रया”",
      "kutra": "ऋग्वेदसंहिता ७/९९/१",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "8185270f-1223-4778-b32f-ad47d8b43939": {
      "text": "इतिपूर्वश्रुतिनिदर्शितः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "13004a66-bba7-48d6-8b67-f49c5509c0ea": {
      "text": "“अन्यमीशम्”",
      "kutra": "आथर्वणोपनिषत् ३/१/२",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      },
      "reference": "45ad9eaf-9bd8-4b55-89c7-c500d3379d74"
    },
    "3e344db2-df64-40a0-a974-e168fe8ace69": {
      "text": "इति श्रुत्या भिन्नजीवदृशं गतः।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "6e086f75-5c84-488a-b729-3c8338b7d0af": {
      "text": "भिन्नत्वेनात्मसादृश्यदो",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "3d9ca604-4445-411f-9510-48278673e663": {
      "text": "“यदा”",
      "kutra": "आथर्वणोपनिषत् ३/१/३",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      },
      "reference": "daedcb24-2326-43bd-a79f-2bd853780d1e"
    },
    "78f2db64-2cfb-43c5-813b-2567399e313c": {
      "text": "इति श्रुतेः सदा॥ १८॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "b340a93a-d887-4a34-8bf7-6761eb6417dc": {
      "text": "उपसंहारः",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "797d23b9-ffde-4780-b4e9-c4240830262b": {
      "text": "मायावादतमोव्याप्तमिति तत्त्वदृशा जगत्।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "99ef82b4-e02e-4308-9eaa-f01b777278ec": {
      "text": "भातं सर्वज्ञसूर्येण प्रीतये श्रीपतेः सदा॥ १९॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "81585081-10fb-408d-a187-95710ff45a8b": {
      "text": "नमोऽमन्दनिजानन्दसान्द्रसुन्दरमूर्तये।",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "ed53ce1d-9e71-46fa-9f30-285bda4bc9de": {
      "text": "इन्दिरापतये नित्यानन्दभोजनदायिने॥ २०॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": ""
      }
    },
    "e60b546c-328c-4272-aae8-07144f0ee0fb": {
      "text": "-",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "“नास्ति नारायणसमं न भूतं न भविष्यति।",
        "trk_patha": "-"
      }
    },
    "21c05332-8461-4f9e-9076-465167b8e0d6": {
      "text": "-",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "एतेन सत्यवाक्येन सर्वार्थान् साधयाम्यहम्॥”",
        "trk_patha": "-"
      }
    },
    "9ce8b208-14fd-471a-a143-b6df0253cb67": {
      "text": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितमुपाधिखण्डनं [तत्त्वप्रकाशिकापरनामकं] सम्पूर्णम्॥",
      "kutra": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितमायावाददूषणं समाप्तम्॥",

        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "f10dbe0d-7d4f-49fc-b8c0-4adfcc8e9b12": {
      "text": "यस्मिन् सर्वाणि भूतान्यात्मैवाभूद् विजानतः।",
      "content_type": "Mula",
      "is_pramana": "",

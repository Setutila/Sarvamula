        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "50808e57-4ecf-4185-864d-9d21b400ad73": {
      "text": "सर्वभूतेषु चात्मानं ततो न वि जुगुप्सते॥ ६॥",
      "content_type": "Inherit",
      "is_pramana": "",

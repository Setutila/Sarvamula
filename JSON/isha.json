    "fd055d48-780b-4279-9ffd-aabe8281351f": {
      "text": "इति शुश्रुम धीराणां ये नस्तद् व्याचचक्षिरे॥ १०॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "source": "",
      "pramana_info": "",

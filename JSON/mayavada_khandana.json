{
  "title": "मायावादखण्डनम्",
  "content": [
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "4e9a7f97-70d7-4c2a-b489-a3093ee543cb",
          "text": "मङ्गलाचरणम्"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "padya": true,
          "children": [
            {
              "id": "2928e02e-1d0b-46bb-a3c1-26811b35dafd",
              "text": "ॐ॥ नरसिंहोऽखिलाज्ञानमतध्वान्तदिवाकरः।"
            },
            {
              "id": "61be8e7e-1c0b-4917-897c-d18e85a5d0ad",
              "text": "जयत्यमितसज्ज्ञानसुखशक्तिपयोनिधिः॥"
            }
          ]
        }
      ]
    },
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "2faad063-4bb3-4afc-86f0-4c93b1a59dba",
          "text": "मायावादस्यानारम्भणीयत्वानुमानम्"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "id": "24aebf10-f7d2-40c2-89aa-c0a1034ade01",
          "text": "विमतमनारम्भणीयम्‌, अन्यथाप्रतिपादकत्वात्, यदित्थं तत् तथा, यथा सम्प्रतिपन्नम्।"
        }
      ]
    },
    {
      "content_type": "Heading2",
      "children": [
        {
          "id": "760ea206-0863-4e97-86a1-0d32680c018f",
          "text": "अयथार्थप्रतिपादकत्वेनान्यथाप्रतिपादकत्वसमर्थनम्"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "id": "c7f91fb9-044a-46cd-8027-ee5e7ee8a6d7",
          "text": "नहि ब्रह्मात्मैक्यस्य याथार्थ्यं तत्पक्षे।"
        },
        {
          "id": "212858c5-ea67-4f79-97c4-d6e1d5ec414f",
          "text": "अद्वैतहानेः स्वरूपातिरेके।"
        },
        {
          "id": "7b24d6a8-1411-4da1-85b3-195f4580ab32",
          "text": "अनतिरेके स्वप्रकाशत्वादात्मनः सिद्धसाधनता।"
        },
        {
          "id": "596f0e13-9cc3-4b8d-aca4-e418a13152af",
          "text": "निर्विशेषत्वाच्चात्मनो नानधिगतो विशेषः।"
        },
        {
          "id": "afdae19f-e34a-45c7-9ae0-89666bf23d26",
          "text": "सिद्धत्वात्‌ स्वरूपस्य विशेषाभावाच्च नाज्ञानं कस्यचिदावरकम्।"
        },
        {
          "id": "1521f0fb-c986-47b6-bc5c-8e4b944aa798",
          "text": "अनधिगतार्थगन्तृ"
        },
        {
          "id": "31d4d22c-4562-4249-a19a-77ae698fb8e6",
          "text": "प्रमाणमिति च तन्मतम्।",
          "bg_patha": "प्रमाणमिति तन्मतम्।",
          "trk_patha": "प्रमाणमिति च तन्मतम्।"
        }
      ]
    },
    {
      "content_type": "Heading2",
      "children": [
        {
          "id": "edf9ae26-4923-407e-95f7-37581764b222",
          "text": "विषयादिरहितत्वेनान्यथाप्रतिपादकत्वसमर्थनम्"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "id": "4cba563b-9326-48d8-b8c1-6235bf3c1bed",
          "text": "अज्ञानासम्भवादेव तन्मतमखिलमपाकृतम्।"
        },
        {
          "id": "bb8eaefd-28ae-4dde-b276-f98c54ef2c2e",
          "text": "मिथ्यात्वे चैक्यस्यातत्त्वावेदकत्वमागमस्य स्यात्।"
        },
        {
          "id": "e70e163f-79d0-490b-a2d0-c7d151d91bc7",
          "text": "सत्यता च भेदस्य।"
        },
        {
          "id": "1619e361-f290-40ad-922a-2c25966421f2",
          "text": "एवमेव प्रयोजनमपि निरस्तम्।"
        },
        {
          "id": "3dbec8b1-298d-486d-a447-73bd02b1cffb",
          "text": "स्वरूपत्वान्मोक्षस्य पूर्वमेव सिद्धत्वात्।"
        },
        {
          "id": "3fcad9b7-b2a5-4701-a604-ca357828c719",
          "text": "अज्ञानासम्भवेन चतुर्थप्रकाराभावात् पञ्चमप्रकारताऽपि निरस्ता।"
        },
        {
          "id": "94ee5abb-40e0-4071-ae93-88c85f8d2a6d",
          "text": "विषयप्रयोजनाभावादेवाधिकारी च।",
          "bg_patha": "विषयप्रयोजनाभावादधिकारी च।",
          "trk_patha": "विषयप्रयोजनाभावादेवाधिकारी च।"
        },
        {
          "id": "748b96fe-3e37-4e60-89ec-47358e683db4",
          "text": "तदभावादेव सम्बन्धोऽपि।"
        }
      ]
    },
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "f2baf9c0-0dcc-455b-9b25-a28959c653fa",
          "text": "विष्णुसर्वोत्तमत्वस्यैव शास्त्रप्रतिपाद्यत्वसमर्थनम्"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "637c0b2a-fa00-4c54-8932-e07b4d768666",
                  "text": "“द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च।",
                  "kutra": "भगवद्गीता १५/१६-२०",
                  "reference": "ed1784c3-daf2-4dfe-bc71-d79cddccbc42"
                },
                {
                  "id": "58290c98-8a20-4749-90af-e776867ef579",
                  "text": "क्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते॥",
                  "reference": "7d0b7cfe-ce06-4092-b3a4-4a82898ec1d8"
                },
                {
                  "id": "8159870c-a295-4871-a008-14a1ca58eda8",
                  "text": "उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः।",
                  "reference": "5452eaad-44ab-4957-8058-dec2074811ac"
                },
                {
                  "id": "154f256e-a58d-42d3-9654-92b8cdbb7698",
                  "text": "यो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः॥",
                  "reference": "7c434d04-d220-490e-a978-0e9056e9269f"
                },
                {
                  "id": "9d645bb9-a309-4942-b7bf-063067d8599b",
                  "text": "यस्मात् क्षरमतीतोऽहमक्षरादपि चोत्तमः।",
                  "reference": "4780f8e5-12e9-4aa4-ac16-84d8d11fa758"
                },
                {
                  "id": "d06a18de-adf1-4ce7-b7d5-7ce3d43e5b30",
                  "text": "अतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः॥",
                  "reference": "987a9605-1e4d-4901-999e-6e3f748ddf57"
                },
                {
                  "id": "a4232189-4f92-4f5d-bda0-eaa1343951ae",
                  "text": "यो मामेवमसम्मूढो जानाति पुरुषोत्तमम्।",
                  "reference": "66da341e-334d-499e-a4db-1e4028ca1de0"
                },
                {
                  "id": "f1865fdb-4ee1-4757-89af-fdb6881f8f3d",
                  "text": "स सर्वविद्‌ भजति मां सर्वभावेन भारत॥",
                  "reference": "195c2c43-c7d2-477e-bbe1-8cfc494509e5"
                },
                {
                  "id": "920b03ad-31ca-461a-9585-ab29572851f8",
                  "text": "इति गुह्यतमं शास्त्रमिदमुक्तं मयाऽनघ।",
                  "reference": "2b011d72-b74a-4d49-8337-4e272fc90133"
                },
                {
                  "id": "c762f097-bd41-4ef4-9c71-ae7dc06f4cee",
                  "text": "एतद्‌ बुद्ध्वा बुद्धिमान् स्यात् कृतकृत्यश्च भारत॥”",
                  "reference": "605af879-a137-41d1-9665-d43651c2818b"
                }
              ]
            }
          ],
          "kutra": "भगवद्गीता १५/१६-२०",
          "link": "ed1784c3-daf2-4dfe-bc71-d79cddccbc42"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "43382c76-e006-40b6-8d58-f4173e37a3cd",
                  "text": "“इन्द्रियेभ्यः परा ह्यर्था अर्थेभ्यश्च परं मनः।",
                  "kutra": "काठकोपनिषत् १/३/१०-११",
                  "bg_patha": "-",
                  "trk_patha": "“इन्द्रियेभ्यः परा ह्यर्था अर्थेभ्यश्च परं मनः।",
                  "reference": "3df8ae1f-c40f-47fc-9886-b75c0195f182"
                },
                {
                  "id": "57156d1b-7b59-47d8-b888-3b464e6b11af",
                  "text": "मनसस्तु परा बुद्धिः बुद्धेरात्मा महान् परः॥",
                  "bg_patha": "-",
                  "trk_patha": "मनसस्तु परा बुद्धिः बुद्धेरात्मा महान् परः॥",
                  "reference": "0f17ac17-9e22-4d8d-8ea1-bf480abcbcd9"
                },
                {
                  "id": "5f3864cc-38d6-420e-b809-7c3dd057a22e",
                  "text": "महतः परमव्यक्तमव्यक्तात् पुरुषः परः।",
                  "bg_patha": "-",
                  "trk_patha": "महतः परमव्यक्तमव्यक्तात् पुरुषः परः।",
                  "reference": "8a98380e-a66f-4f44-a835-0b677b452028"
                },
                {
                  "id": "760da132-45df-4bb2-b4b7-55b3bb98ec01",
                  "text": "पुरुषान्न परं किञ्चित् सा काष्ठा सा परा गतिः॥”",
                  "bg_patha": "-",
                  "trk_patha": "पुरुषान्न परं किञ्चित् सा काष्ठा सा परा गतिः॥”",
                  "reference": "fcdfe13e-7fc2-46d3-b55a-c0a0d6c6ffa8"
                }
              ]
            }
          ],
          "kutra": "काठकोपनिषत् १/३/१०-११",
          "link": "3df8ae1f-c40f-47fc-9886-b75c0195f182"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "eef3b505-056c-4a0f-9746-33e916835e1c",
                  "text": "“भूम्नः क्रतुवज्ज्यायस्त्वं तथा च दर्शयति”",
                  "kutra": "ब्रह्मसूत्रम् ३/३/५९",
                  "bg_patha": "-",
                  "trk_patha": "“भूम्नः क्रतुवज्ज्यायस्त्वं तथा च दर्शयति”",
                  "reference": "943048b7-2ed1-4746-b9f0-d31dffca9864"
                }
              ]
            }
          ],
          "kutra": "ब्रह्मसूत्रम् ३/३/५९",
          "link": "943048b7-2ed1-4746-b9f0-d31dffca9864"
        },
        {
          "id": "f34f5515-8eb3-4449-ad47-760039708dfb",
          "text": "इति विष्णोः"
        },
        {
          "id": "81079453-cf90-42ae-8069-5271dac491a6",
          "text": "पुरुषोत्तमत्वमेव सर्वशास्त्रार्थत्वेन भगवता श्रुत्या चाभिहितम्।",
          "bg_patha": "सर्वोत्तमत्वमेव सर्वशास्त्रार्थत्वेन भगवताऽभिहितम्।",
          "trk_patha": "पुरुषोत्तमत्वमेव सर्वशास्त्रार्थत्वेन भगवता श्रुत्या चाभिहितम्।"
        }
      ]
    },
    {
      "content_type": "Heading1",
      "children": [
        {
          "id": "9a0927ee-4748-43e6-bb99-2f525335bb83",
          "text": "उपसंहारः"
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "padya": true,
          "children": [
            {
              "id": "22003abc-a928-44ed-ae71-d8bf63490759",
              "text": "इति सर्वज्ञमुनिना मायावादतमोऽखिलम्।"
            },
            {
              "id": "255d1216-4972-4d8d-b482-db3f623ec81d",
              "text": "निरस्तं तत्त्ववादेन सतां संशयनुत्तये॥"
            }
          ]
        }
      ]
    },
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "pramana": true,
          "children": [
            {
              "padya": true,
              "children": [
                {
                  "id": "9723d08d-8644-4743-9c30-c77e10e937b9",
                  "text": "“नास्ति नारायणसमं न भूतं न भविष्यति।",
                  "kutra": "भारतम् १/१/२८"
                },
                {
                  "id": "b784c386-1072-4fac-a520-7e00d1eb8a1c",
                  "text": "एतेन सत्यवाक्येन सर्वार्थान् साधयाम्यहम्॥”"
                }
              ]
            }
          ],
          "kutra": "भारतम् १/१/२८"
        }
      ]
    },
    {
      "content_type": "Colophon_Sarvamula",
      "children": [
        {
          "id": "a8672adc-3f65-4687-9147-055c39ee9b92",
          "text": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं मायावादखण्डनं सम्पूर्णम्॥",
          "bg_patha": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यकृतं मायावाददूषणं समाप्तम्॥",
          "trk_patha": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं मायावादखण्डनं सम्पूर्णम्॥"
        }
      ]
    }
  ],

{
  "title": "jk",
  "content": [
    {
      "content_type": "Sarvamula",
      "children": [
        {
          "padya": true,
          "children": [
            {
              "id": "901e938c-4dd4-4415-b03f-16c009cc9fb2",
              "text": "रोहिण्यामर्धरात्रे तु यदा"
            },
            {
              "id": "60f51970-3f4d-44e2-860b-19aa37f0735c",
              "text": "कालाष्टमी",
              "bg_patha": "“काळाष्टमी”",
              "trk_patha": "“कालाष्टमी”"
            },
            {
              "id": "cf8942fd-8578-40a6-9617-6b4c6ce9ffef",
              "text": "भवेत्।"
            },
            {
              "id": "0d69ed73-3cd4-45ff-a385-bab84080338d",
              "text": "जयन्ती नाम सा प्रोक्ता"
            },
            {
              "id": "7119f3bc-d89c-4f2b-ae86-585c262cf324",
              "text": "सर्वपापप्रणाशनी",
              "bg_patha": "“सर्वपापप्रणाशनम्”",
              "trk_patha": "“सर्वपापप्रणाशनी”"
            },
            {
              "id": "dc81a0e7-fb19-4d20-a23b-a627cdcbad95",
              "text": "॥ १॥"
            },
            {
              "id": "f4eb679b-2695-4fe4-b851-95dfc6c2146c",
              "text": "यस्यां जातो हरिः साक्षान्निशीथे भगवानजः।"
            },
            {
              "id": "67cf58b5-d327-4c2c-aa88-e37666bc61bc",
              "text": "तस्मात्"
            },
            {
              "id": "ffe868a7-efda-4d48-b694-1b4331d5a402",
              "text": "तद्दिनमत्यन्तं",
              "bg_patha": "“तद्दिनमत्यर्थं”",
              "trk_patha": "“तद्दिनमत्यन्तं”"
            },
            {
              "id": "bfe0d1e1-bf52-45f7-ab97-deb8f1372d9f",
              "text": "पुण्यं पापहरं परम्॥ २॥",
              "pathanatara": "“पापहरं स्मृतम्” - पा। “पापहानिकरं परम्” पा।"
            },
            {
              "id": "f69de205-d5ff-4630-a9ff-abc6008a75d6",
              "text": "तस्मात् सर्वैरुपोष्या सा जयन्ती नाम वै सदा।"
            },
            {
              "id": "97a253d2-55da-49a1-9300-912c7ae8afb4",
              "text": "द्विजातिभिर्विशेषेण तद्भक्तैश्च"
            },
            {
              "id": "fc00c9c3-dfcd-4307-9aaf-c136c7a39ff4",
              "text": "विशेषतः",
              "bg_patha": "“विधानतः”",
              "trk_patha": "“विशेषतः”"
            },
            {
              "id": "bd79f2fe-39fa-493d-9f98-63a15b59badb",
              "text": "॥ ३॥"
            },
            {
              "id": "8ed784ae-5374-42f4-a087-3ae33fcb20dc",
              "text": "यो भुङ्क्ते तद्दिने"
            },
            {
              "id": "7fc00fad-ca93-4f08-ae0a-7e48ec2ca4bb",
              "text": "मोहात्",
              "bg_patha": "“लोभात्”",
              "trk_patha": "“मोहात्”"
            },
            {
              "id": "e8b01da1-ae7c-4903-a89f-8f6d74b97e14",
              "text": "पूयशोणितमत्ति सः।"
            },
            {
              "id": "49bdc405-7d44-4c9b-9b34-80997a427cb0",
              "text": "तस्मादुपवसेत् पुण्यं तद्दिनं श्रद्धयाऽन्वितः॥ ४॥"
            },
            {
              "id": "5ad9cfa7-24b1-4a4f-ad56-9b5e3f168314",
              "text": "कृत्वा शौचं यथान्यायं स्नानं कुर्यादतन्द्रितः।"
            },
            {
              "id": "ffcaf2d7-f207-49a0-8f5d-de7d21ebe7fa",
              "text": "प्रभातकाले मेधावी योगायेति यथाविधि॥ ५॥"
            },
            {
              "id": "ae09f1a1-726f-4b6c-b0a7-eb8caff91936",
              "text": "(योगाय योगपतये योगेश्वराय योगसम्भवाय श्रीगोविन्दाय नमोनमः।)",
              "bg_patha": "“[-]”",
              "trk_patha": "“नित्याह्निकं प्रकुर्वीत भगवन्तमनुस्मरन्”",
              "pathanatara": "कृपाठेऽपि कंसचिह्नमध्य एव पठ्यते, किन्तु नित्याह्निकमित्यर्धस्यानन्तरम्।"
            },
            {
              "id": "d213515e-8e9a-4769-8377-b3dc576eb8f9",
              "text": "नित्याह्निकं प्रकुर्वीत भगवन्तमनुस्मरन्।",
              "bg_patha": "“नित्याह्निकं प्रकुर्वीत भगवन्तमनुस्मरन्”",
              "trk_patha": "“(योगाय योगपतये योगेश्वराय योगसम्भवाय श्रीगोविन्दाय नमोनमः।)”"
            },
            {
              "id": "c17e9666-a07f-4469-8196-6429ac8e45db",
              "text": "मध्याह्नकाले च"
            },
            {
              "id": "e965b1bf-e71c-4e9a-b4f0-fec26ce4ebc0",
              "text": "पुमान्",
              "bg_patha": "“पुनः”",
              "trk_patha": "“पुमान्”"
            },
            {
              "id": "d224479d-054d-48b0-8845-ed98bb9dbbe6",
              "text": "सायङ्काले त्वतन्द्रितः॥ ६॥"
            },
            {
              "id": "4bf880de-ebc2-4ecb-aaef-f1c2eefb0509",
              "text": "स्नायीत पूर्वमन्त्रेण वासुदेवमनुस्मरन्।",
              "pathanatara": "‘भगवन्तमनुस्मरन्’ - पा।"
            },
            {
              "id": "0e1801fb-cff3-4951-adf5-4b3dbfacbe9b",
              "text": "ततः पूजां प्रकुर्वीत विधिवत् सुसमाहितः॥ ७॥"
            },
            {
              "id": "eb9139cf-4c27-4e07-9db5-f97a8dd9ced3",
              "text": "यज्ञायेति च मन्त्रेण श्रद्धाभक्तियुतः पुमान्।",
              "pathanatara": "‘यज्ञायेति तु’ - पा।"
            },
            {
              "id": "1c9bb4d8-7431-4b17-a09b-0ce4a2b36048",
              "text": "कृष्णं च बलभद्रं च वसुदेवं च देवकीम्॥ ८॥"
            },
            {
              "id": "9590797e-d748-42b4-b470-228ee45d1155",
              "text": "नन्दगोपं यशोदां च सुभद्रां तत्र पूजयेत्।"
            },
            {
              "id": "c47afe28-fb0c-4cab-b00b-398a2716884a",
              "text": "अर्घ्यं दत्वा"
            },
            {
              "id": "22ec11bd-6b31-4197-85f0-adc982b7317a",
              "text": "समभ्यर्च्याभ्युत्थिते",
              "bg_patha": "“समभ्यर्च्याभ्युदिते”",
              "trk_patha": "“समभ्यर्च्याभ्युत्थिते”",
              "pathanatara": "‘समभ्यर्च्य ह्युदिते’ - पा।"
            },
            {
              "id": "195f4552-3d35-42b2-b636-2f197485e9bb",
              "text": "शशिमण्डले॥ ९॥"
            },
            {
              "id": "2992fc96-6301-4b36-9a93-a0bab31a0b56",
              "text": "जातः कंसवधार्थाय भूभारोत्तारणाय च।",
              "bg_patha": "“[-]”",
              "trk_patha": "“जातः कंसवधार्थाय भूभारोत्तारणाय च”"
            },
            {
              "id": "c373771a-8931-4b79-a04b-4149e22272a9",
              "text": "कौरवाणां विनाशाय दैत्यानां निधनाय च॥ १०॥",
              "bg_patha": "“[-]”",
              "trk_patha": "“कौरवाणां विनाशाय दैत्यानां निधनाय च॥ १०”"
            },
            {
              "id": "4065dc46-8995-428e-913e-f5c0c7b42ed5",
              "text": "पाण्डवानां हितार्थाय धर्मसंस्थापनाय च।",
              "bg_patha": "“[-]”",
              "trk_patha": "“पाण्डवानां हितार्थाय धर्मसंस्थापनाय च”"
            },
            {
              "id": "f9eaa01b-9974-4a26-a9d0-8454134ccc39",
              "text": "गृहाणार्घ्यं मया दत्तं देवक्या सहितो हरे॥ ११॥",
              "bg_patha": "“[-]”",
              "trk_patha": "“गृहाणार्घ्यं मया दत्तं देवक्या सहितो हरे॥ ११”"
            },
            {
              "id": "e5dcb488-0735-460b-b1b1-685538c1fe8e",
              "text": "क्षीरोदार्णवसम्भूत"
            },
            {
              "id": "50156c05-46c5-45c7-b068-a600ced79ae5",
              "text": "अत्रिगोत्रसमुद्धव।",
              "bg_patha": "“अत्रिनेत्रसमुद्धव”",
              "trk_patha": "“अत्रिगोत्रसमुद्धव”"
            },
            {
              "id": "3460b92e-7ade-426c-8b81-03f23ecd924f",
              "text": "गृहाणार्घ्यं"
            },
            {
              "id": "36f19842-7735-460e-ab65-4b401e5c29c7",
              "text": "मया दत्तं",
              "bg_patha": "“शशाङ्केदं”",
              "trk_patha": "“मया दत्तं”"
            },
            {
              "id": "27ed0627-f69d-45af-af47-666a98679bde",
              "text": "रोहिण्या सहितः शशिन्॥ १२॥"
            },
            {
              "id": "987b8939-4009-40f5-89b8-f658c80b7512",
              "text": "दत्वाऽर्घ्यं मनुनाऽनेन"
            },
            {
              "id": "f77f53e2-132f-4a6a-8f96-6de7bdb6c4e8",
              "text": "ह्युपस्थाय",
              "bg_patha": "“उपस्थाय”",
              "trk_patha": "“ह्युपस्थाय”"
            },
            {
              "id": "3659e118-46a6-4524-88ea-e9aa03fdeadd",
              "text": "विधुं बुधः।"
            },
            {
              "id": "ac7940ef-b1e7-4947-861d-151c8fd488ce",
              "text": "शशिने चन्द्रदेवाय सोमदेवाय चेन्दवे॥ १३॥"
            },
            {
              "id": "70185618-ed1c-49a6-8f8d-c6d6daf87657",
              "text": "मृगिणे"
            },
            {
              "id": "66750130-2e48-46bc-8c8b-eaef55d5650a",
              "text": "शीतबिम्बाय",
              "bg_patha": "“सितबिम्बाय”",
              "trk_patha": "“शीतबिम्बाय”",
              "pathanatara": "‘शशिबिम्बाय’ - पा। गोविन्दाचार्यास्तु “ ‘रोहिणीसक्तचित्ताय कन्यादानप्रदायिने’ इत्यधिकं च क्वचित् पठ्यते” इत्याहुः।"
            },
            {
              "id": "cba2d8dc-075e-4f66-884e-c3ff49b0c3d5",
              "text": "लोकदीपाय दीपिने।"
            },
            {
              "id": "7d1ad77d-485f-4306-b8b9-65c5c3054755",
              "text": "शीतदीधितिबिम्बाय तारकापतये नमः॥ १४॥"
            },
            {
              "id": "30effdae-9fca-4e03-bb5e-eac1e7212ca5",
              "text": "उपसंहृत्य तत् सर्वं ब्रह्मचारी जितेन्द्रियः।"
            },
            {
              "id": "25ba147c-d146-490a-a1b9-05a4a1de7c76",
              "text": "विश्वायेति च मन्त्रेण ततः स्वापं समाचरेत्॥ १५॥"
            },
            {
              "id": "92cdfe44-4f4e-47d1-baac-9649f08ce34b",
              "text": "ततो नित्याह्निकं कृत्वा शक्तितो दीयतां धनम्।"
            },
            {
              "id": "d46ed61f-957d-4c92-94b0-edbcf3edf048",
              "text": "सर्वायेति च मन्त्रेण ततः पारणमाचरेत्॥"
            },
            {
              "id": "62222ef2-1ca3-4a22-892f-8b5cf5be6ba2",
              "text": "धर्मायेति ततः स्वस्थो मुच्यते सर्वकिल्बिषैः॥ १६॥"
            }
          ]
        }
      ]
    },
    {
      "content_type": "Colophon_Sarvamula",
      "children": [
        {
          "id": "43a5cd2e-c446-473f-9516-a3d0f9c6cb94",
          "text": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितो जयन्तीनिर्णयः सम्पूर्णः ॥",
          "bg_patha": "“॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितः श्रीमज्जयन्तीकल्पः समाप्तः ”",
          "trk_patha": "“॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितो जयन्तीनिर्णयः सम्पूर्णः ”",
          "pathanatara": "जयन्तीकल्पः"
        }
      ]
    }
  ],

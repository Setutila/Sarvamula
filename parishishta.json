        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "2c2c52ac-0554-4fa9-b3cd-3c2df0c33ee1": {
      "text": "श्रीमत्कण्ठीरवास्यप्रततसुनखरादारितारातिदूर-",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",

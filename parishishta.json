        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "ecfa6010-8e53-476d-bb5a-3973ca1959f0": {
      "text": "नमामि पितरं नित्यं वासुदेवं जगत्पतिम्॥ १॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": "‘रमानाथं जगत्पतिम्’ इति क्वचित्।"
      }
    },
    "cab51fd6-dc0f-4571-bbd1-b842b3b36b24": {
      "text": "सच्चिदानन्दरूपं तमनामयमनन्तरम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",

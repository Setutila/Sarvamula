        "pathanatara": ""
      }
    },
    "0f216424-38ce-4e23-b514-890e67844241": {
      "text": "सन्ततमस्मान् पातु मुरारिः सततगसमजवखगपतिनिरतः॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",

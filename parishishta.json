      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "cf6ede54-6101-4a04-848e-2f39a3e20f0f": {
      "text": "शङ्खचक्रधरं वन्दे वराभयकरोद्यतम्‌॥ ११॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "a126c170-79b8-4242-a6a3-17fd7a0367d1": {
      "text": "प्रतापप्रविशेषेण दूरीकृतविदूषणम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "d105de0c-3ae4-4c7c-a767-d21a86e2d094": {
      "text": "विदारितारिमत्यन्तप्रसन्नं प्रणमाम्यहम्‌॥ १२॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "d84e29b2-26f3-4dd7-ace1-198490a8124a": {
      "text": "अप्रमेयमजं नित्यं विशालममृतं परम्‌।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "cf1ad90a-0488-49dc-aeb5-fe82bb8897cf": {
      "text": "कृतनित्यालयालोके नमस्यामि जगत्पतिम्॥ १३॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": "‘कृतनित्यालयं लोके’ इति स्यादिति गोविन्दाचार्याः।"
      }
    },
    "2093dd64-0e00-498f-b58e-b0a04135af62": {
      "text": "सुनित्यसुखमक्षय्यं शुद्धं शान्तं निरञ्जनम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "c0b2742f-0dcf-4b72-9604-e8f1b676184d": {
      "text": "लोकालोकविचाराढ्यं नमस्यामि श्रियः पतिम्॥ १४॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "5620580f-15b2-40ab-8f5a-fcac6b15a7ec": {
      "text": "अमन्दानन्दसन्दोहसान्द्रमिन्द्रानुजं परम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "f98fdc3d-3c8a-475c-b303-2db8963a4c65": {
      "text": "नित्यावदातमेकान्तं प्रमाणातीतमक्षयम्‌।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "d4983384-c6a6-40d8-a120-17da9e26db21": {
      "text": "लोकालोकपतिं दिव्यं नमस्यामि रमापतिम्॥ १५॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "cf139848-0964-4e62-840c-bc0c2475f5bb": {
      "text": "पद्यानि कानिचित्",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "fef5be39-8d94-4d93-8630-766f1d056ebd": {
      "text": "रामोऽखिलानन्दतनुः स एव भीमोऽतिपापेषु दुरन्तवीर्यः।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं द्वादशस्तोत्राणां मध्ये प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "a3639e60-763e-4edf-bdf6-45a5d4a208b9": {
      "text": "कामः स एवाजितकामिनीषु सोमः स एवात्मपदाश्रितेषु॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "4c302f9a-9a7c-476e-bb1a-f133c91520e1": {
      "text": "चञ्चलोऽयं मनोमीनः समानेयो हरिस्थले।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं तत्त्वसङ्ख्यानानन्तरं प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "3cca403c-4747-4d78-a311-10fa5d6115f2": {
      "text": "विषयोदकसञ्चारी सद्भक्तिबडिशाहृतः॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "cc771006-6400-4950-8c83-39efc4bbe6b2": {
      "text": "प्रादेशमात्रं तत्त्वार्थे जयार्थेऽरत्निमात्रकम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं तत्त्वसङ्ख्यानानन्तरं प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "dc46cb6a-e642-466c-974a-0299c0ba76cf": {
      "text": "ख्यातिपूजार्थिनो हस्तमात्रं पत्रमुदाहृतम्॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "acce2666-f47d-4de5-a62c-1085e79c5133": {
      "text": "असम्बद्धप्रवचनमसम्बद्धाः प्रवृत्तयः।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं कथालक्षणानन्तरं प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "5795b316-2061-434d-acb3-0f33063fecf1": {
      "text": "प्रतिज्ञायाश्च सन्त्यागः कथायाः पूर्वनिग्रहः॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "c93f3f7f-e81c-4555-9014-9287e6af89b7": {
      "text": "श्रुतिर्नाम समुद्दिष्टं लिङ्गं तल्लक्षणं स्मृतम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं कथालक्षणान्ते ब्रह्मसूत्रभाष्यान्ते च प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः। उदाहृतानि चेमानि तत्त्वप्रदीपे।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "082ce1e0-3ce6-413b-967d-90e93e8c8ee6": {
      "text": "पदानि निरपेक्षाणि वाक्यं प्रकरणं तथा।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "7938cf2a-df30-4f24-b261-c839e2ae2d93": {
      "text": "एकस्य प्रतिपत्त्यङ्गवचनं स्थानमुच्यते।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "3c9dfd32-f002-4cdc-a555-84eb72d7db0d": {
      "text": "अन्यत्र तत्समोक्तिस्तु समाख्या स्थानमेव च।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "e737da9e-8eb8-43ab-83b8-10dc51d71404": {
      "text": "अध्यायादिप्रबन्धास्तु प्रभेदा आगमस्य च॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "c3595507-3f77-4a95-948f-1453ae4dfad6": {
      "text": "श्रुत्वा तद्दिनमारभ्य दशाहमशुचिर्भवेत्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं सदाचारस्मृत्यन्ते प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "7dd771c1-5631-40f4-a3b9-81b15bda6aea": {
      "text": "पितरौ तु मृतौ स्यातां दूरस्थोऽपिच पुत्रकः॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "437308df-b3e8-45df-9b6a-981cf98d3233": {
      "text": "अतिक्रान्ते दशाहे तु त्रिरात्रमशुचिर्भवेत्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "इदं पद्यं सदाचारस्मृत्यन्ते प्राचीनकोशे पठ्यते इति गोविन्दाचार्याः।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "c44fa50d-f442-4caa-bee2-f5d744c6788e": {
      "text": "संवत्सरे व्यतीते तु स्पृष्ट्वैवापो विशुद्ध्यति॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "2c72dff0-a470-4385-88e4-6b0e0839a358": {
      "text": "ज्ञातिविषयमेतत्।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "106c006e-4d45-421c-bdcc-f3991fa7ceae": {
      "text": "वाक्यमेकम्",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "9c0bfd24-c1c6-4f20-8dfd-094845c537ca": {
      "text": "बिल्वमङ्गलः साधुः।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    }
  }
}
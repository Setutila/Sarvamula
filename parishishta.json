        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "b6b4beb0-f802-45cc-99a6-14548d70bce7": {
      "text": "कुम्भोच्चाद्रिविपाटनाधिकपटुप्रत्येकवज्रायिताः।",
      "content_type": "Inherit",

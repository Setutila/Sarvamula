      }
    },
    "442544fd-0407-4dd2-a004-66e1dfe83365": {
      "text": "लक्ष्मीकान्त समन्ततो विकलयन् नैवेशितुस्ते समं",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "d49b7832-60be-42e3-a291-1eb981b09aaf": {
      "text": "पश्याम्युत्तमवस्तु दूरतरतोऽपास्तं रसो योऽष्टमः।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "8ec0bcef-faf9-44dc-95c6-f0ba86d072d9": {
      "text": "यद्रोषोत्करदक्षनेत्रकुटिलप्रान्तोत्थिताग्निस्फुर-",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "4ae26a83-25e0-4c46-bbb7-4959ec38fdd5": {
      "text": "त्खद्योतोपमविस्फुलिङ्गभसिता ब्रह्मेशशक्रोत्कराः॥ *॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",

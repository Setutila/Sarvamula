      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "2732d311-3bda-4c0f-b42f-3ea6f1118b65": {
      "text": "ज्ञानमुद्रापुस्तकादिशङ्खाक्षायुधधारिणम्॥ ४॥",

        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "847c034c-d023-447e-9698-48f8f151fa4c": {
      "text": "पान्त्वस्मान् पुरुहूतवैरिबलवन्मातङ्गमाद्यद्घटा-",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {

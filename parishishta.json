    "391d3bb0-6ece-4048-ba46-f0b92196d7dc": {
      "text": "कन्दुकस्तुतिः",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "“श्रीकृष्णपद्यम्”",
        "trk_patha": "“कन्दुकस्तुतिः”",
        "pathanatara": ""
      }
    },
    "3be77591-7093-4df2-bb72-14a3cd957cb0": {
      "text": "अम्बरगङ्गाचुम्बितपादः पदतलविदलितगुरुतरशकटः",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "89c9a7b4-aa4a-45c2-877a-db63841bb578": {
      "text": "कालियनागक्ष्वेलनिहन्ता",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "“कालियनागक्ष्वेळनिहन्ता”",
        "trk_patha": "“कालियनागक्ष्वेलनिहन्ता”",
        "pathanatara": ""
      }
    },
    "59b090ce-e120-44bd-99ca-0d09917f7ba8": {
      "text": "सरसिजनवदलविकसितनयनः।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inline",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",

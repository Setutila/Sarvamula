      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": "‘---खगपतिनिलयः’ इति क्वचित्।"
      }
    },
    "e0da64f7-73a4-45bd-99e3-3c25d34625ed": {
      "text": "स्तोत्रमेकम्",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "गोविन्दाचार्याणां पाठे द्वादशस्तोत्रेषु तृतीयत्वेनेदं पठ्यते। न पठ्यते कुत्राप्यन्यत्र।",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "9e565690-15ed-44b2-9664-ab677ba22aea": {
      "text": "शङ्खचक्रगदापद्मशार्ङ्गखड्गधरं सदा।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",

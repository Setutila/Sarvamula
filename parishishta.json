      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "a96f759b-2366-4853-9b8d-d4407707f9b6": {
      "text": "एकमेकान्तमभयं विष्णुं विश्वहृदि स्थितम्॥ २॥",

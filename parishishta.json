    "62eaaacc-a555-475c-bc02-06967570464b": {
      "text": "कुन्देन्दुसन्निभं वन्दे सुधारसनिभं विभुम्‌।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",

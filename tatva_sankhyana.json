      }
    },
    "efa49bc4-6a7f-402b-bd30-3efe004539c0": {
      "text": "--- --- ---भावाभावौ द्विधेतरत्‌॥ १॥",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "6d88b962-8c70-4f0f-b0b0-5cd275a73db0": {
      "text": "अभावविभागनिर्देशौ",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "bf9c972f-9227-4574-bd7b-cba91548cd75": {
      "text": "प्राक्प्रध्वंससदात्वेन त्रिविधोऽभाव इष्यते।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "43bb9cf0-da13-4b50-b5c6-31c8a6f8f678": {
      "text": "भावविभागनिर्देशौ",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "ba9cc299-420a-46e5-b987-74997d170b89": {
      "text": "चेतनाचेतनत्वेन भावोऽपि द्विविधो मतः॥ २॥",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "62dc963b-cc4c-4936-9de8-54a0808741d8": {
      "text": "चेतनविभागादि",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "b465a756-cffa-4e32-85e5-ec7d1ef974da": {
      "text": "दुःखस्पृष्टं तदस्पृष्टमिति द्वेधैव चेतनम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "286f81c1-2c2f-47b4-aa54-94be5d896163": {
      "text": "नित्यादुःखा रमाऽन्ये तु स्पृष्टदुःखाः समस्तशः॥ ३॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "4c591149-1bfe-4e86-90e5-7b28e277e999": {
      "text": "स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "c8e65fee-9d01-4bb4-acb1-21d8e487eead": {
      "text": "दुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा॥ ४ ॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "9dcbcb81-372a-4974-bec5-1a6d2b9a9dea": {
      "text": "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "5e36a6d6-2074-420c-9a7a-e7a6766330e7": {
      "text": "एवं विमुक्तियोग्याश्च तमोगाः सृतिसंस्थिताः॥ ५ ॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "7b9999e4-ba23-4055-ac64-c8ad3c9d42c3": {
      "text": "इति द्विधा मुक्त्ययोग्या दैत्यरक्षःपिशाचकाः।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "086ca3b6-fa25-42c4-8dbd-28e17f2300bd": {
      "text": "मर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः॥ ६ ॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "35e3fafe-c088-4b0e-8bfe-5890492991c4": {
      "text": "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "b4f595e6-7226-4fd2-97c6-256f5b35288b": {
      "text": "अचेतनविभागादि",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "e578cbea-d476-4aff-8fa9-949f7597bdff": {
      "text": "नित्यानित्यविभागेन त्रिधैवाचेतनं मतम्॥ ७ ॥",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "021cae0d-5b7a-47a3-91e9-606d251d7d6e": {
      "text": "नित्या वेदाः पुराणाद्याः कालः प्रकृतिरेव च।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "9a4aa42b-d994-47d6-ba02-6dbe038b0319": {
      "text": "नित्यानित्यं त्रिधा प्रोक्तमनित्यं द्विविधं मतम्॥ ८ ॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": "द्विविधं स्मृतमिति क्वचित्।"
      }
    },
    "0395b8f4-f90e-4f4e-be51-35171a0e27d6": {
      "text": "असंसृष्टं च संसृष्टमसंसृष्टं महानहम्।",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "95a5ac28-ef9a-4742-a11d-c8301e89be5c": {
      "text": "बुद्धिर्मनः खानि दश मात्रा भूतानि पञ्च च॥ ९ ॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "45c08174-cd61-46fa-b3a9-c438fdb82fdd": {
      "text": "संसृष्टमण्डं तद्गं च समस्तं सम्प्रकीर्तितम्।",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "db0cc121-e84f-4243-b55f-8f12392de102": {
      "text": "स्वतन्त्रास्वतन्त्रसम्बन्धप्रदर्शनपूर्वक उपसंहारः",
      "content_type": "Heading1",
      "is_pramana": "",
      "is_padya": "",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "3214a1b1-a4c0-4446-902a-b8fb081fe543": {
      "text": "सृष्टिः स्थितिः संहृतिश्च नियमोऽज्ञानबोधने॥ १०॥",
      "content_type": "Sarvamula",
      "is_pramana": "",
      "is_padya": "Yes",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "49018b39-bf85-4640-914b-ddcdfb5151f4": {
      "text": "बन्धो मोक्षः सुखं दुःखमावृतिर्ज्योतिरेव च॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
    "980f98af-29b7-48e8-83e0-9382b1aa95ad": {
      "text": "विष्णुनाऽस्य समस्तस्य समासव्यासयोगतः॥ ११ ॥",
      "content_type": "Inherit",
      "is_pramana": "",
      "is_padya": "Inherit",
      "kutra": "",
      "footnote": "",
      "pratika_type": "",
      "pathanatara": {
        "bg_patha": "",
        "trk_patha": "",
        "pathanatara": ""
      }
    },
